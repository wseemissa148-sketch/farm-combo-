local configFile = "BloxFruitsConfig.json"

local function SaveConfig()
    pcall(function()
        if writefile then
            writefile(configFile, HttpService:JSONEncode(_G.Config))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(configFile) then
            local decoded = HttpService:JSONDecode(readfile(configFile))
            for k, v in pairs(decoded) do
                if type(v) == "table" and type(_G.Config[k]) == "table" then
                    for k2, v2 in pairs(v) do _G.Config[k][k2] = v2 end
                else
                    _G.Config[k] = v
                end
            end
        end
    end)
end

