-- وظيفة حساب حالة القمر والوقت المتبقي للـ Full Moon
local function GetMoonInfo()
    local clockTime = Lighting.ClockTime
    local moonPhase = Lighting:GetMoonPhase()
    -- في لعبة Blox Fruits، الفل مون يحدث غالباً عندما يكون وقت اللعبة ليلاً متقدماً أو عبر حسابات الأطوار
    local isFullMoon = (moonPhase == Enum.MoonPhase.FullMoon) or (clockTime >= 0 and clockTime < 5)
    
    local moonText = tostring(moonPhase):gsub("Enum.MoonPhase.", "")
    if isFullMoon then
        return "YES (متاح الآن!)", moonText
    else
        return "NO (غير مرسبن)", moonText
    end
end

-- وظيفة التحقق من وجود جزيرة الكتسوني أو الميراج في العالم
local function CheckKitsuneIsland()
    local targetIsland = Workspace:FindFirstChild("KitsuneIsland") or Workspace:FindFirstChild("SeaEvent") or Workspace:FindFirstChild("MirageIsland")
    -- البحث في الخريطة عن أي جزء يخص الكتسوني
    for _, v in pairs(Workspace:GetChildren()) do
        if v.Name:lower():find("kitsune") or v.Name:lower():find("kitsuneisland") then
            return "Found (مرسبنة وفي العالم! 🦊)"
        end
    end
    return "Not Found (غير موجودة حالياً)"
end

