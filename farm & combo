        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true

        local label = Instance.new("TextLabel")
        label.Parent = billboard
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.Text = "🍎 " .. fruit.Name
        label.TextColor3 = Color3.fromRGB(0, 255, 127)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold

        billboard.Parent = handle
    end
end

function RemoveFruitESP(fruit)
    local handle = fruit:FindFirstChild("Handle") or fruit:FindFirstChildOfClass("Part") or fruit
    if handle and handle:FindFirstChild("FruitESP") then
        handle.FruitESP:Destroy()
    end
end

task.spawn(function()
    while task.wait(0.5) do
        local char = player.Character
        for _, item in pairs(workspace:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Fruit") or item:FindFirstChild("Handle")) then
                if _G.Config.FruitESP then
                    AddFruitESP(item)
                else
                    RemoveFruitESP(item)
                end
                
                if _G.Config.AutoGrab then
                    local handle = item:FindFirstChild("Handle")
                    if handle and char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = handle.CFrame
                    end
                end
            end
        end
    end
end)
