function FastAttackUniversal()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local targets = {}
    local enemies = Workspace:FindFirstChild("Enemies")
    
    if enemies then
        for _, mob in pairs(enemies:GetChildren()) do
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (char.HumanoidRootPart.Position - hrp.Position).Magnitude <= 70 then
                    table.insert(targets, hrp)
                end
            end
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (char.HumanoidRootPart.Position - hrp.Position).Magnitude <= 70 then
                    local shouldAttackPlayer = true
                    if _G.Config.EnableFastAttackStop then
                        local stopValue = tonumber(_G.Config.FastAttackStopHealth) or 3000
                        if hum.Health <= stopValue then
                            shouldAttackPlayer = false
                        end
                    end
                    if shouldAttackPlayer then
                        table.insert(targets, hrp)
                    end
                end
            end
        end
    end

    if #targets > 0 then
        pcall(function()
            ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack"):FireServer(0.001)
            for _, hitTarget in pairs(targets) do
                local attackId = tostring(math.random(100000, 999999))
                ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit"):FireServer(hitTarget, {}, attackId)
            end
        end)
        
        local equippedTool = char:FindFirstChildOfClass("Tool")
        if equippedTool then
            equippedTool:Activate()
        end
    end
end

task.spawn(function()
    while true do
        if _G.Config.FastAttack or _G.Config.TargetPVP then
            FastAttackUniversal()
        end
        task.wait(_G.Config.AttackDelay)
    end
end)

-- نظام الفواكه ESP والالتقاط
function AddFruitESP(fruit)
    local handle = fruit:FindFirstChild("Handle") or fruit:FindFirstChildOfClass("Part") or fruit
    if handle and not handle:FindFirstChild("FruitESP") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "FruitESP"
        billboard.Adornee = handle
        billboard.Size = UDim2.new(0, 100, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true

        local label = Instance.new("TextLabel")
        label.Parent = billboard
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.Text = "🍎 " .. fruit.Name
        label.TextColor3 = Color3.fromRGB(0, 255, 127)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold

        billboard.Parent = handle
    end
end

function RemoveFruitESP(fruit)
    local handle = fruit:FindFirstChild("Handle") or fruit:FindFirstChildOfClass("Part") or fruit
    if handle and handle:FindFirstChild("FruitESP") then
        handle.FruitESP:Destroy()
    end
end

