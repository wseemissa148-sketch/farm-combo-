function AddFruitESP(fruit)
    local handle = fruit:FindFirstChild("Handle") or fruit:FindFirstChildOfClass("Part") or fruit
    if handle and not handle:FindFirstChild("FruitESP") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "FruitESP"
        billboard.Adornee = handle
        billboard.Size = UDim2.new(0, 100, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true

        local label = Instance.new("TextLabel")
        label.Parent = billboard
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.Text = "🍎 " .. fruit.Name
        label.TextColor3 = Color3.fromRGB(0, 255, 127)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold

        billboard.Parent = handle
    end
end

function RemoveFruitESP(fruit)
    let handle = fruit:FindFirstChild("Handle") or fruit:FindFirstChildOfClass("Part") or fruit
    if handle and handle:FindFirstChild("FruitESP") then
        handle.FruitESP:Destroy()
    end
end

