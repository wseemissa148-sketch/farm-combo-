local function CreateDynamicDropdown(parentPage, title, getOptionsFunc, configVar, onSelectCallback)
    local DropdownFrame = Instance.new("Frame")
    DropdownFrame.Size = UDim2.new(0.96, 0, 0, 32)
    DropdownFrame.BackgroundColor3 = Color3.fromRGB(24, 27, 38)
    DropdownFrame.ClipsDescendants = true
    DropdownFrame.Parent = parentPage

    local FrameCorner = Instance.new("UICorner")
    FrameCorner.CornerRadius = UDim.new(0, 6)
    FrameCorner.Parent = DropdownFrame

    local MainBtn = Instance.new("TextButton")
    MainBtn.Size = UDim2.new(1, 0, 0, 32)
    MainBtn.BackgroundTransparency = 1
    MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
    MainBtn.TextColor3 = Color3.fromRGB(0, 170, 255)
    MainBtn.Font = Enum.Font.GothamBold
    MainBtn.TextSize = 9
    MainBtn.TextXAlignment = Enum.TextXAlignment.Left
    MainBtn.Parent = DropdownFrame

    local OptionsHolder = Instance.new("ScrollingFrame")
    OptionsHolder.Position = UDim2.new(0, 4, 0, 32)
    OptionsHolder.Size = UDim2.new(1, -8, 0, 0)
    OptionsHolder.BackgroundTransparency = 1
    OptionsHolder.ScrollBarThickness = 3
    OptionsHolder.Visible = false
    OptionsHolder.Parent = DropdownFrame

    local HolderLayout = Instance.new("UIListLayout")
    HolderLayout.Padding = UDim.new(0, 3)
    HolderLayout.Parent = OptionsHolder

    local isOpen = false

    local function RebuildOptions()
        for _, child in pairs(OptionsHolder:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        local currentOptions = getOptionsFunc()
        local itemHeight = 24
        local maxVisibleItems = 5
        local visibleCount = math.min(#currentOptions, maxVisibleItems)
        local containerHeight = visibleCount * (itemHeight + 3)

        OptionsHolder.Size = UDim2.new(1, -8, 0, containerHeight)
        OptionsHolder.CanvasSize = UDim2.new(0, 0, 0, #currentOptions * (itemHeight + 3))

        for _, opt in ipairs(currentOptions) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(0.98, 0, 0, itemHeight)
            OptBtn.BackgroundColor3 = Color3.fromRGB(32, 36, 50)
            OptBtn.Text = tostring(opt)
            OptBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            OptBtn.Font = Enum.Font.GothamMedium
            OptBtn.TextSize = 9
            OptBtn.Parent = OptionsHolder

            local OptCorner = Instance.new("UICorner")
            OptCorner.CornerRadius = UDim.new(0, 5)
            OptCorner.Parent = OptBtn

            OptBtn.MouseButton1Click:Connect(function()
                _G.Config[configVar] = opt
                SaveConfig()
                MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
                isOpen = false
                OptionsHolder.Visible = false
                DropdownFrame.Size = UDim2.new(0.96, 0, 0, 32)
                if onSelectCallback then onSelectCallback(opt) end
            end)
        end
        return containerHeight
    end

    MainBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local containerHeight = RebuildOptions()
            OptionsHolder.Visible = true
            DropdownFrame.Size = UDim2.new(0.96, 0, 0, 36 + containerHeight)
            MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▲"
        else
            OptionsHolder.Visible = false
            DropdownFrame.Size = UDim2.new(0.96, 0, 0, 32)
            MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
        end
    end)

    return {
        Refresh = function()
            MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
            if isOpen then 
                local containerHeight = RebuildOptions()
                DropdownFrame.Size = UDim2.new(0.96, 0, 0, 36 + containerHeight)
            end
        end
    }
end

